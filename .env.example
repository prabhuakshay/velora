# Copy to .env and fill in. Every variable is read by config/settings.py.
# Values shown are the defaults; variables marked REQUIRED have none.
# Commented-out variables have computed defaults: uncomment only to override.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# REQUIRED. Long random string used for signing sessions, tokens and cookies.
# Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Shows detailed error pages and relaxes the security settings below.
# Never True in production.
DEBUG=False

# Comma-separated hostnames this site can serve, e.g. velora.example.com,localhost
ALLOWED_HOSTS=

# Comma-separated origins (with scheme) trusted for unsafe requests such as
# form posts, e.g. https://velora.example.com
CSRF_TRUSTED_ORIGINS=

# URL path of the Django admin. Change it to something hard to guess.
# Must end with a slash.
ADMIN_URL=admin/

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection URL: postgres://USER:PASSWORD@HOST:PORT/NAME
# Inside Docker, localhost is the container: use host.docker.internal for a
# database running on this machine.
DATABASE_URL=postgres://velora:velora@localhost:5432/velora

# Seconds to keep a database connection open for reuse. 0 closes it after each
# request.
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# Cache backend URL. locmemcache:// is per-process memory.
# Use redis://HOST:6379/0 when running several processes.
CACHE_URL=locmemcache://

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Minimum number of characters a user password must have.
PASSWORD_MIN_LENGTH=12

# How long a login lasts, in seconds. Default: 14 days.
SESSION_COOKIE_AGE=1209600

# ---------------------------------------------------------------------------
# Brute-force protection
# Rate limits are counted in the cache: with several processes, use a shared
# one (CACHE_URL=redis://...) or each process counts separately.
# ---------------------------------------------------------------------------

# Number of reverse proxies (nginx, Caddy, load balancer) between clients and
# the app that add the client IP to X-Forwarded-For. Used to find the real
# client IP for lockouts and rate limits. Leave 0 when there is no proxy:
# clients could otherwise fake their IP.
TRUSTED_PROXY_COUNT=0

# Failed logins allowed per email + IP before that pair is locked out.
AXES_FAILURE_LIMIT=5

# Hours a locked-out email + IP pair stays locked.
AXES_COOLOFF_HOURS=1

# Max login form posts per IP, as count/period (s, m, h, d), e.g. 20/m.
LOGIN_RATE_LIMIT=20/m

# Max password reset requests per IP.
PASSWORD_RESET_RATE_LIMIT=5/h

# ---------------------------------------------------------------------------
# Internationalization
# ---------------------------------------------------------------------------

# Default language, e.g. en-us, en-in.
LANGUAGE_CODE=en-us

# Time zone used to display dates and times, e.g. Asia/Kolkata.
# Values are always stored in UTC.
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Static and media files
# ---------------------------------------------------------------------------

# URL prefix for CSS/JS/images that ship with the code.
STATIC_URL=static/

# Folder where `manage.py collectstatic` puts static files. Default: ./staticfiles
# STATIC_ROOT=/var/www/velora/staticfiles

# URL prefix for files uploaded by users.
MEDIA_URL=media/

# Folder where user uploads are stored. Default: ./media
# MEDIA_ROOT=/var/www/velora/media

# ---------------------------------------------------------------------------
# Security
# Defaults depend on DEBUG: strict when DEBUG=False, relaxed when DEBUG=True.
# ---------------------------------------------------------------------------

# Redirect every HTTP request to HTTPS. Default: True unless DEBUG.
# SECURE_SSL_REDIRECT=True

# Tells browsers to use only HTTPS for this many seconds (HSTS).
# Default: 31536000 (1 year) unless DEBUG, then 0.
# Start small (e.g. 3600) on a new domain: browsers remember this value.
# SECURE_HSTS_SECONDS=31536000

# Apply HSTS to all subdomains too. Default: True unless DEBUG.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Allow submitting the domain to browsers' built-in HSTS preload list.
# Hard to undo; only enable once HTTPS works on every subdomain.
SECURE_HSTS_PRELOAD=False

# Send session and CSRF cookies only over HTTPS. Default: True unless DEBUG.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Set True when running behind a reverse proxy (nginx, Caddy, a PaaS) that
# terminates HTTPS and sends the X-Forwarded-Proto header. Leave False
# otherwise: clients could fake the header.
# With compose.prod.yaml behind a proxy, set this True and TRUSTED_PROXY_COUNT=1.
USE_X_FORWARDED_PROTO=False

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Email backend class. Default: console backend (prints emails) when DEBUG,
# SMTP otherwise.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server settings. Only used with the SMTP backend.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use STARTTLS (port 587) or implicit TLS (port 465). Enable only one.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds to wait for the SMTP server before giving up.
EMAIL_TIMEOUT=10

# Sender address for emails to users.
DEFAULT_FROM_EMAIL=webmaster@localhost

# Sender address for error emails to ADMINS. Default: DEFAULT_FROM_EMAIL
# SERVER_EMAIL=errors@example.com

# Text added to the start of error email subjects.
EMAIL_SUBJECT_PREFIX="[Velora] "

# Comma-separated email addresses that receive server error (500) reports.
ADMINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level printed to the console: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Docker
# Read by compose.yaml (dev) and compose.prod.yaml (prod), not by Django.
# ---------------------------------------------------------------------------

# Host port the app is published on: http://localhost:PORT
# Prod binds it to 127.0.0.1 only; put a reverse proxy in front.
DOCKER_HOST_PORT=8000

# Dev containers run as this user so files they write into the repo (compiled
# CSS, migrations) stay owned by you. Match `id -u` and `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000

# Prod container ceilings.
DOCKER_CPU_LIMIT=2.0
DOCKER_MEMORY_LIMIT=1g

# Gunicorn (prod). Keep 1 worker: rate limits live in locmem, per process.
# Each thread can hold a database connection, so
# workers x threads is the connection count to budget for.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
